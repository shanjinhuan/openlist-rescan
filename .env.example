# 复制本文件为 .env，然后填入真实值

# ── OpenList ─────────────────────────────────────────────
# 容器内访问宿主机服务用 172.17.0.1；宿主机自己也跑着 OpenList 时可直接用 127.0.0.1
OPENLIST_URL=http://172.17.0.1:5245
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=change-me

# ── 扫描参数 ─────────────────────────────────────────────
SCAN_PATH=/strm
SCAN_LIMIT=3
# 等扫描完成的最长秒数，超过就本轮不刷新影视
SCAN_WAIT_MAX=1500

# ── 飞牛影视（trim.media）自动刷新 ───────────────────────
# 1 = 扫描完成后自动刷新媒体库；0 = 关闭
MEDIA_REFRESH_ENABLE=1
# 容器内访问宿主机影视服务（内部端口 8005）
MEDIA_URL=http://172.17.0.1:8005
MEDIA_USERNAME=change-me
MEDIA_PASSWORD=change-me
# scanall = 刷新全部媒体库；refresh = 走 /mdb/refresh
MEDIA_MODE=scanall
#
# 另外：影视签名所需的应用级常量从 $DATA_DIR/keys.local 读取（不进版本库）：
#   MEDIA_APP_SECRET=...
#   MEDIA_APP_KEY=...

# ── Web 控制台 ───────────────────────────────────────────
WEB_PORT=8090
DATA_DIR=/data

# ── 其它 ─────────────────────────────────────────────────
CRON_SCHEDULE=*/20 * * * *
# debug 会打印每次执行详情
LOG_LEVEL=info
